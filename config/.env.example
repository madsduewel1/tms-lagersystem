# TMS Lager – Backend-Konfiguration
# Pfad der install.sh anlegen: config/.env

NODE_ENV=production

HOST=0.0.0.0
PORT=3000

# Erzeugen mit: openssl rand -hex 32
JWT_SECRET=please-change-me
JWT_EXPIRES_IN=8h

# Hinter TLS (nginx/Apache mit Zertifikat) zwingend true setzen, sonst laufen
# Session- und CSRF-Cookies unverschlüsselt über HTTP.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# HSTS in Sekunden, nur sinnvoll mit echtem TLS (z. B. 31536000 = 1 Jahr).
# 0 = aus.
HSTS_MAX_AGE=0

# Reverse-Proxy-Vertrauen: '' = Produktions-Default (nur Loopback),
# 'false', '1', IP-Liste etc. siehe README.
TRUST_PROXY=

DB_HOST=localhost
DB_PORT=3306
DB_USER=tms
# Muss in Produktion geändert werden – der Dev-Default wird abgelehnt.
# Erzeugen mit: openssl rand -hex 16
DB_PASSWORD=tms_lager_dev
DB_NAME=tms_lager

# In Entwicklung: wo Vite läuft (für CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Öffentliche Basis-URL für QR-Codes und Labels (ohne abschließenden Slash).
# In Produktion verpflichtend, sonst erzeugt der Host-Header die QR-URLs.
# PUBLIC_BASE_URL=https://example.org/lagersystem
